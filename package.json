{
  "name": "bcglove",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Une web-app privée pour deux personnes : un compteur, une question, une réponse.",
  "scripts": {
    "dev": "vite",
    "dev:full": "npm run build && wrangler pages dev --port 8788",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json && tsc --noEmit -p tsconfig.functions.json",
    "lint": "eslint . --max-warnings 0",
    "test": "node --experimental-strip-types --test \"src/lib/*.test.ts\"",
    "docs:check": "node scripts/docs-check.mjs",
    "db:migrate": "wrangler d1 migrations apply bcglove --local",
    "db:migrate:prod": "wrangler d1 migrations apply bcglove --remote",
    "keys:vapid": "node scripts/gen-vapid.mjs",
    "check": "npm run docs:check && npm run lint && npm run typecheck && npm test",
    "db:seed": "node scripts/seed-users.mjs --local",
    "db:seed:prod": "node scripts/seed-users.mjs --remote",
    "test:api": "node scripts/api-smoke.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250109.0",
    "@types/node": "^26.5.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@typescript-eslint/eslint-plugin": "^8.20.0",
    "@typescript-eslint/parser": "^8.20.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^8.57.1",
    "eslint-plugin-react-hooks": "^5.1.0",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "wrangler": "^3.99.0"
  }
}
