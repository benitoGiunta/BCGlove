# Secrets attendus par les Pages Functions.
# En local : copier ce fichier vers .dev.vars et le remplir. .dev.vars est git-ignoré.
# En production : les poser avec `wrangler pages secret put <NOM> --project-name bcglove`.
#
# Ne jamais mettre de valeur réelle dans ce fichier.

VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:
